ARG RANCHER_TAG=dev
ARG RANCHER_REPO=rancher
FROM ${RANCHER_REPO}/rancher:${RANCHER_TAG} as rancher

ARG ARCH=amd64

FROM ghcr.io/verrazzano/golang:v1.20.12 as build
ARG ARCH
ENV ARCH=$ARCH

COPY . /go/src/github.com/rancher/rancher/

RUN dnf config-manager --enable ol8_appstream && \
    dnf install -y git && \
    cd /go/src/github.com/rancher/rancher/scripts && \
    ./build

FROM ghcr.io/oracle/oraclelinux:8-slim
ARG ARCH=amd64

RUN microdnf update -y --setopt=install_weak_deps=0 --setopt=tsflags=nodocs && \
    microdnf install -y git jq iproute vim bash-completion unzip sysstat hostname && \
    microdnf install -y dnf && \
    microdnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --add-repo http://yum.oracle.com/repo/OracleLinux/OL8/olcne17/x86_64 && \
    microdnf install -y kubectl-1.26.6-1.el8.x86_64

RUN rm -f /bin/sh && ln -s /bin/bash /bin/sh
ENV KUBECTL_VERSION v1.23.6

# Update PATH to make sure git 2.27 is on the path
ENV PATH="/opt/rh/rh-git227/root/usr/bin:${PATH}"

ENV LOGLEVEL_VERSION v0.1.5

RUN curl -sLf https://github.com/rancher/loglevel/releases/download/${LOGLEVEL_VERSION}/loglevel-${ARCH}-${LOGLEVEL_VERSION}.tar.gz | tar xvzf - -C /usr/bin

ARG VERSION=dev
LABEL io.cattle.agent true
ENV AGENT_IMAGE rancher/rancher-agent:${VERSION}
ENV SSL_CERT_DIR /etc/kubernetes/ssl/certs

COPY --from=rancher /var/lib/rancher-data /var/lib/rancher-data
COPY --from=rancher /usr/bin/tini /usr/bin/
COPY --from=build /go/src/github.com/rancher/rancher/bin/agent /usr/bin/
COPY --from=build /go/src/github.com/rancher/rancher/package/run.sh /usr/bin/
COPY --from=build /go/src/github.com/rancher/rancher/package/kubectl-shell.sh /usr/bin/
COPY --from=build /go/src/github.com/rancher/rancher/package/shell-setup.sh /usr/bin/
RUN mkdir /license
COPY --from=build /go/src/github.com/rancher/rancher/LICENSE /license/
COPY --from=build /go/src/github.com/rancher/rancher/README.md /license/
COPY --from=build /go/src/github.com/rancher/rancher/THIRD_PARTY_LICENSES.txt /license/
WORKDIR /var/lib/rancher
ENTRYPOINT ["run.sh"]
